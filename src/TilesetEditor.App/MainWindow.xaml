<Window x:Class="TilesetEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:TilesetEditor.App.Shell"
        Title="{Binding WindowTitle}" Width="1500" Height="920" MinWidth="1100" MinHeight="650" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PanelBrush}" Icon="pack://application:,,,/Assets/decompkit.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <shell:ModuleIconConverter x:Key="ModuleIcon"/>
    </Window.Resources>
    <DockPanel>
        <!-- Roof: logo, name, project, project-wide actions -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource RoofBrush}" Padding="14,8">
            <Border.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource RoofButton}"/>
            </Border.Resources>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PorymapStatus}" Foreground="#FFE4E4" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"
                               MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding PorymapStatus}"/>
                    <Button Content="🗺 Open in Porymap" Command="{Binding OpenInPorymapCommand}" Visibility="{Binding IsEmerald, Converter={StaticResource BoolVis}}"/>
                    <Button Content="▶ Build ROM" Command="{Binding BuildCommand}" FontWeight="SemiBold"/>
                    <Button Content="🎮 Emulator" Command="{Binding OpenInEmulatorCommand}"
                            ToolTip="Available after a successful build if an emulator is set (Setup…)."/>
                    <Button Content="Build output" Command="{Binding ToggleBuildPanelCommand}"/>
                    <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" Padding="9,4"
                            ToolTip="Light / dark mode"/>
                    <Button Content="{Binding AppUpdateButtonText}" Command="{Binding AppUpdateCommand}" Margin="0" Padding="9,4"
                            ToolTip="{Binding AppUpdateTip}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="23" Background="#EEFFFFFF" Margin="0,-5,10,-5" ToolTip="{Binding GameLogoTip}">
                        <Image Source="{Binding GameLogo, TargetNullValue={StaticResource LogoImage}}" Width="38" Height="38" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Foreground="White" FontSize="19" FontWeight="Bold">
                            <Run Text="PokéPat"/><Run Text=" DecompKit" FontWeight="Light"/>
                        </TextBlock>
                        <TextBlock Text="{Binding GameSubtitle}" Foreground="#FFD6D6" FontSize="10"/>
                    </StackPanel>
                    <Button Content="Open project…" Command="{Binding OpenProjectCommand}"/>
                    <Button Content="Setup…" Command="{Binding SetupCommand}" ToolTip="Get started: choose the game (Emerald or Platinum), install or check the project, emulator and build tools – or set paths manually"/>
                    <ComboBox ItemsSource="{Binding RecentProjects}" Width="26" ToolTip="Recently opened" Margin="0,0,10,0" x:Name="Recent"
                              SelectionChanged="OnRecentSelected" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProjectHeader}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="420" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- White band under the roof, like the front of the building -->
        <Border DockPanel.Dock="Top" Height="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PinkStrongBrush}" BorderThickness="0,0,0,1"/>

        <!-- Notice: updates found by the check on start -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource WarnBannerBrush}" BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="0,0,0,1" Padding="12,5"
                Visibility="{Binding HasUpdateNotice, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Later" Command="{Binding DismissUpdateNoticeCommand}" Margin="0"/>
                <Button DockPanel.Dock="Right" Content="Show updates…" Command="{Binding ShowUpdatesCommand}"/>
                <Button DockPanel.Dock="Right" Content="⬆ Update PokéPat…" Command="{Binding AppUpdateCommand}" FontWeight="SemiBold"
                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding UpdateNotice}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Notice: project re-read after outside changes (Porymap, git) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource WarnBannerBrush}" BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="0,0,0,1" Padding="12,5"
                Visibility="{Binding HasProjectNotice, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="OK" Command="{Binding DismissNoticeCommand}" Margin="0"/>
                <TextBlock Text="{Binding ProjectNotice}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Status bar: build result -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Command="{Binding CancelBuildCommand}" Visibility="{Binding IsBuilding, Converter={StaticResource BoolVis}}"/>
                    <Button Content="Show ROM in Explorer" Command="{Binding ShowRomInExplorerCommand}" Margin="0"
                            Visibility="{Binding BuildSucceeded, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <ProgressBar DockPanel.Dock="Left" Width="90" Height="8" IsIndeterminate="True" Margin="0,0,10,0"
                             Visibility="{Binding IsBuilding, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding BuildStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BuildSucceeded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsBuilding}" Value="True"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Build output panel -->
        <Border DockPanel.Dock="Bottom" Height="250" Visibility="{Binding ShowBuildPanel, Converter={StaticResource BoolVis}}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="#2A2121">
            <DockPanel>
            <!-- Problems of a failed build: click to jump to the place -->
            <DockPanel DockPanel.Dock="Left" Width="520" Visibility="{Binding HasBuildProblems, Converter={StaticResource BoolVis}}">
                <TextBlock DockPanel.Dock="Top" Margin="10,6,6,2" Foreground="#F5E9E6" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="Problems – click one to go there. The first one is usually the cause."/>
                <ListBox x:Name="ProblemList" ItemsSource="{Binding BuildProblems}" Background="#2A2121" BorderThickness="0" Margin="4,0,0,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Build problems">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Foreground" Value="#F5E9E6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="ToolTip" Value="{Binding ShowTip}"/>
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnProblemClicked"/>
                            <EventSetter Event="KeyDown" Handler="OnProblemKey"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="📄" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Top" FontSize="11"
                                        ToolTip="Open the file at this line in your editor"
                                        Visibility="{Binding HasFile, Converter={StaticResource BoolVis}}"
                                        Command="{Binding DataContext.OpenProblemFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Where}" FontFamily="Consolas" FontSize="11" Foreground="#F2B8A8" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11.5"/>
                                    <TextBlock Text="{Binding ShowIn, StringFormat=→ {0}}" FontSize="10.5" Foreground="#A8D8B0"
                                               Visibility="{Binding CanShow, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <TextBox Text="{Binding BuildOutput, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     Background="#2A2121" Foreground="#F5E9E6" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="OnBuildOutputChanged">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,6" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <Border DockPanel.Dock="Left" Width="214" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" BorderThickness="0" Padding="6,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Modules">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="Transparent" CornerRadius="10" Margin="0,2" Padding="0,6,8,6">
                                        <DockPanel>
                                            <Border x:Name="Marker" DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,8,2" Background="Transparent"/>
                                            <ContentPresenter/>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource PinkBrush}"/>
                                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource PinkBrush}"
                                    BorderBrush="{DynamicResource PinkStrongBrush}" BorderThickness="1" Margin="0,0,9,0" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Title, Converter={StaticResource ModuleIcon}}" FontFamily="Segoe UI Emoji" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <ContentControl Content="{Binding SelectedModule.View}"/>
    </DockPanel>
</Window>
