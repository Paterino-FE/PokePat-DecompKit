<Window x:Class="TilesetEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:TilesetEditor.App.Shell"
        Title="{Binding WindowTitle}" Width="1500" Height="920" MinWidth="1100" MinHeight="650" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PanelBrush}" Icon="{StaticResource LogoImage}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <shell:ModuleIconConverter x:Key="ModuleIcon"/>
    </Window.Resources>
    <DockPanel>
        <!-- Roof: logo, name, project, project-wide actions -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RoofBrush}" Padding="14,8">
            <Border.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource RoofButton}"/>
            </Border.Resources>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PorymapStatus}" Foreground="#FFE4E4" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"
                               MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding PorymapStatus}"/>
                    <Button Content="🗺 Open in Porymap" Command="{Binding OpenInPorymapCommand}"/>
                    <Button Content="▶ Build ROM" Command="{Binding BuildCommand}" FontWeight="SemiBold"/>
                    <Button Content="🎮 Emulator" Command="{Binding OpenInEmulatorCommand}"
                            ToolTip="Available after a successful build if an emulator is set (Setup…)."/>
                    <Button Content="Build output" Command="{Binding ToggleBuildPanelCommand}" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource LogoImage}" Width="34" Height="34" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Foreground="White" FontSize="19" FontWeight="Bold">
                            <Run Text="PokéPat"/><Run Text=" DecompKit" FontWeight="Light"/>
                        </TextBlock>
                        <TextBlock Text="for pokeemerald-expansion" Foreground="#FFD6D6" FontSize="10"/>
                    </StackPanel>
                    <Button Content="Open project…" Command="{Binding OpenProjectCommand}"/>
                    <Button Content="Setup…" Command="{Binding SetupCommand}" ToolTip="Project folder and tool paths (Porymap, emulator, Porytiles, build)"/>
                    <ComboBox ItemsSource="{Binding RecentProjects}" Width="26" ToolTip="Recently opened" Margin="0,0,10,0" x:Name="Recent"
                              SelectionChanged="OnRecentSelected" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProjectHeader}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="420" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- White band under the roof, like the front of the building -->
        <Border DockPanel.Dock="Top" Height="5" Background="White" BorderBrush="{StaticResource PinkStrongBrush}" BorderThickness="0,0,0,1"/>

        <!-- Notice: project re-read after outside changes (Porymap, git) -->
        <Border DockPanel.Dock="Top" Background="#FFF4D6" BorderBrush="#F2B544" BorderThickness="0,0,0,1" Padding="12,5"
                Visibility="{Binding HasProjectNotice, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="OK" Command="{Binding DismissNoticeCommand}" Margin="0"/>
                <TextBlock Text="{Binding ProjectNotice}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Status bar: build result -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Command="{Binding CancelBuildCommand}" Visibility="{Binding IsBuilding, Converter={StaticResource BoolVis}}"/>
                    <Button Content="Show ROM in Explorer" Command="{Binding ShowRomInExplorerCommand}" Margin="0"
                            Visibility="{Binding BuildSucceeded, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <ProgressBar DockPanel.Dock="Left" Width="90" Height="8" IsIndeterminate="True" Margin="0,0,10,0"
                             Visibility="{Binding IsBuilding, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding BuildStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#B8212B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BuildSucceeded}" Value="True"><Setter Property="Foreground" Value="#2E7D4F"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsBuilding}" Value="True"><Setter Property="Foreground" Value="#3B2F2F"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Build output panel -->
        <Border DockPanel.Dock="Bottom" Height="230" Visibility="{Binding ShowBuildPanel, Converter={StaticResource BoolVis}}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#2A2121">
            <TextBox Text="{Binding BuildOutput, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     Background="#2A2121" Foreground="#F5E9E6" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="OnBuildOutputChanged">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,6" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Border>

        <!-- Navigation -->
        <Border DockPanel.Dock="Left" Width="214" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" BorderThickness="0" Padding="6,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Modules">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="Transparent" CornerRadius="10" Margin="0,2" Padding="0,6,8,6">
                                        <DockPanel>
                                            <Border x:Name="Marker" DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,8,2" Background="Transparent"/>
                                            <ContentPresenter/>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#FFF4F4"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource PinkBrush}"/>
                                            <Setter TargetName="Marker" Property="Background" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Background="{StaticResource PinkBrush}"
                                    BorderBrush="{StaticResource PinkStrongBrush}" BorderThickness="1" Margin="0,0,9,0" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Title, Converter={StaticResource ModuleIcon}}" FontFamily="Segoe UI Emoji" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <ContentControl Content="{Binding SelectedModule.View}"/>
    </DockPanel>
</Window>
