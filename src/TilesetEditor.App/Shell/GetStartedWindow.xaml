<Window Icon="pack://application:,,,/Assets/decompkit.ico" x:Class="TilesetEditor.App.Shell.GetStartedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokéPat DecompKit – Get started" Width="860" Height="900" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <DockPanel Margin="18,14,18,14">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Welcome to PokéPat DecompKit!" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentDarkBrush}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                       Text="PokéPat downloads and sets up everything you need for your own Pokémon game. Choose the game you want to hack, check the two folders, then click &quot;Install everything&quot;. You can also install single parts – anything that is already there is kept."/>
        </StackPanel>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="I already have a project – set paths manually…" Click="Advanced"
                    ToolTip="Choose an existing project folder, build command, Porymap, emulator and Porytiles yourself."/>
            <CheckBox DockPanel.Dock="Left" Content="Check for updates when PokéPat starts" IsChecked="{Binding CheckUpdatesOnStart}"
                      VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="At most once a day; a notice appears at the top when something is new."/>
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="80" Margin="0"/>
            <Button DockPanel.Dock="Right" x:Name="FinishButton" Content="Open my project" FontWeight="SemiBold" MinWidth="150" Click="Finish"
                    IsEnabled="{Binding ProjectReady}" ToolTip="Saves the folders and programs and opens the project in PokéPat."/>
        </DockPanel>

        <!-- PokéPat itself -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource WarnBannerBrush}" BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,5" Margin="0,8,0,0" Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Download page" Command="{Binding OpenAppUpdateCommand}" Margin="0"/>
                <TextBlock Text="{Binding AppUpdateText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Details / log -->
        <Expander DockPanel.Dock="Bottom" Header="Details" Margin="0,8,0,0" x:Name="LogExpander">
            <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Height="150"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,4,0,0"/>
        </Expander>

        <!-- Actions -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="⬇  Install everything" FontWeight="SemiBold" FontSize="14" Padding="18,6" Command="{Binding InstallAllCommand}"
                    ToolTip="Installs every missing part in order. Steps that need you (password, Ubuntu's first start) open their own window."/>
            <Button Content="Check again" Command="{Binding CheckCommand}"/>
            <Button Content="⟳ Check for updates" Command="{Binding CheckUpdatesCommand}"
                    ToolTip="Asks GitHub for the newest versions of the programs, of your game's base project and of PokéPat."/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
            <ProgressBar IsIndeterminate="True" Width="90" Height="6" Margin="6,0,10,0" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
        </DockPanel>

        <!-- Game -->
        <GroupBox DockPanel.Dock="Top" Header="1 · Which game do you want to hack?">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="Game" IsChecked="{Binding IsEmerald}" Margin="0,2,24,2" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Pokémon Emerald">
                        <StackPanel>
                            <TextBlock Text="💚 Pokémon Emerald" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Game Boy Advance · pokeemerald-expansion" Style="{StaticResource Hint}" FontSize="11"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Game" IsChecked="{Binding IsPlatinum}" Margin="0,2,0,2" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Pokémon Platinum">
                        <StackPanel>
                            <TextBlock Text="🤍 Pokémon Platinum" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Nintendo DS · pret/pokeplatinum" Style="{StaticResource Hint}" FontSize="11"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <TextBlock Text="{Binding GameHint}" Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Folders -->
        <GroupBox DockPanel.Dock="Top" Header="2 · Folders">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Your game (project):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding ProjectPath, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                         AutomationProperties.Name="Project folder" ToolTip="A Linux path; ~ is your Linux home folder. The folder must be new or empty – or an existing project."/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding UsesWsl, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="in" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Distros}" Text="{Binding Distro, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="130"
                              AutomationProperties.Name="WSL distribution"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,8"
                           Text="Lives inside WSL (Linux) – building the ROM is much faster there than on C:\."/>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" FontSize="11" Margin="0,17,0,8"
                           Text="{Binding ProjectHint}"/>
                <TextBlock Grid.Row="2" Text="Programs folder:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ToolsFolder, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Programs folder"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Click="BrowseTools" Margin="8,0,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,0"
                           Text="{Binding ToolsHint}"/>
            </Grid>
        </GroupBox>

        <!-- Components -->
        <GroupBox Header="3 · What PokéPat sets up">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MarkText" Text="{Binding Mark}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Margin="4,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" FontSize="11"/>
                                        <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="UpdateLine" Text="{Binding UpdateText}" TextWrapping="Wrap" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource MutedBrush}" Visibility="{Binding HasUpdateText, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <Button Content="{Binding ButtonText}" Command="{Binding InstallCommand}" MinWidth="96" Margin="0"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BoolVis}}"/>
                                        <Button Content="⬆ Update" Command="{Binding UpdateCommand}" MinWidth="96" Margin="0" FontWeight="SemiBold"
                                                Visibility="{Binding CanUpdate, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Look}" Value="Ready">
                                    <Setter TargetName="MarkText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Look}" Value="Failed">
                                    <Setter TargetName="MarkText" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Look}" Value="NeedsUser">
                                    <Setter TargetName="MarkText" Property="Foreground" Value="{DynamicResource WarnTextBrush}"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource WarnTextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                    <Setter TargetName="UpdateLine" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="UpdateLine" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Look}" Value="Working">
                                    <Setter TargetName="MarkText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </DockPanel>
</Window>
