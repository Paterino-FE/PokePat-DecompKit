<Application x:Class="TilesetEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        PokéPat DecompKit theme – the colors of a Pokémon Center: red roof, white walls, warm cream floor,
        soft pink highlights. Implicit styles below restyle every module without touching its XAML.
    -->
    <Application.Resources>
        <!-- Palette -->
        <Color x:Key="CenterRed">#E3343A</Color>
        <Color x:Key="CenterRedDark">#B8212B</Color>
        <Color x:Key="CenterRedDeep">#8E1820</Color>
        <Color x:Key="CenterPink">#FDE8E8</Color>
        <Color x:Key="CenterPinkStrong">#F9C9CB</Color>
        <Color x:Key="CenterCream">#FFF8F2</Color>
        <Color x:Key="CenterLine">#EBD9D4</Color>
        <Color x:Key="CenterInk">#3B2F2F</Color>
        <Color x:Key="CenterMuted">#7D6B69</Color>

        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CenterRed}"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource CenterRedDark}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource CenterCream}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource CenterLine}"/>
        <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource CenterPink}"/>
        <SolidColorBrush x:Key="PinkStrongBrush" Color="{StaticResource CenterPinkStrong}"/>
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource CenterInk}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource CenterMuted}"/>
        <LinearGradientBrush x:Key="RoofBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EF4A4F" Offset="0"/>
            <GradientStop Color="{StaticResource CenterRed}" Offset="0.55"/>
            <GradientStop Color="{StaticResource CenterRedDark}" Offset="1"/>
        </LinearGradientBrush>

        <!-- Base text -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Buttons: white pill with red outline; SemiBold buttons are the main action and filled red. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PinkStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource PinkBrush}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource PinkStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="FontWeight" Value="SemiBold">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="FontWeight" Value="SemiBold"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Buttons on the red roof bar -->
        <Style x:Key="RoofButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#88FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="FontWeight" Value="SemiBold">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Inputs -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PinkStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FCF6F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PinkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Lists -->
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="#FFF2F2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="{StaticResource PinkStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tables -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFAF7"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3E7E3"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F3E7E3"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PinkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource PinkStrongBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PinkStrongBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tabs: white cards with a red underline on the selected one -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Background="Transparent" Padding="14,6" Margin="0,0,4,0" CornerRadius="8,8,0,0" BorderThickness="0,0,0,3"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource PinkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="White"/>
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PinkStrongBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <!-- The DecompKit badge: a red-and-white capsule ball (drawn, no image files). -->
        <DrawingImage x:Key="LogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White" Geometry="M 0,16 A 16,16 0 1 1 32,16 A 16,16 0 1 1 0,16 Z">
                        <GeometryDrawing.Pen><Pen Brush="#3B2F2F" Thickness="2"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource AccentBrush}" Geometry="M 1,15 A 15,15 0 0 1 31,15 Z"/>
                    <GeometryDrawing Brush="#3B2F2F" Geometry="M 1,14.5 L 31,14.5 L 31,17.5 L 1,17.5 Z"/>
                    <GeometryDrawing Brush="White" Geometry="M 11,16 A 5,5 0 1 1 21,16 A 5,5 0 1 1 11,16 Z">
                        <GeometryDrawing.Pen><Pen Brush="#3B2F2F" Thickness="2"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource PinkBrush}" Geometry="M 13.5,16 A 2.5,2.5 0 1 1 18.5,16 A 2.5,2.5 0 1 1 13.5,16 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Application.Resources>
</Application>
