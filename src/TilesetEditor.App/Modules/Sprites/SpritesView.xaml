<UserControl x:Class="TilesetEditor.App.Modules.Sprites.SpritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="6">
    <TabItem Header="Overworld sprites">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,8,0">
            <TextBox DockPanel.Dock="Top" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                     AutomationProperties.Name="Search sprites" ToolTip="Search sprite or palette"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding Sprites}" SelectedItem="{Binding Selected}" FontFamily="Consolas" FontSize="11"
                     VirtualizingPanel.IsVirtualizing="True"/>
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Overworld sprite" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Details}" FontFamily="Consolas" TextWrapping="Wrap"/>
                <Border Background="{DynamicResource BorderBrush}" HorizontalAlignment="Left" Padding="6" Margin="0,8,0,6">
                    <Image Source="{Binding Preview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Replace image…" Command="{Binding ReplaceOverworldCommand}" ToolTip="Replace this sprite sheet with an edited one of the same size"/>
                    <Button Content="Save a copy to edit…" Command="{Binding SaveOverworldCopyCommand}"/>
                </StackPanel>

                <Border BorderBrush="{DynamicResource PinkStrongBrush}" BorderThickness="1" Background="{DynamicResource HoverBrush}" Padding="10" CornerRadius="4" HorizontalAlignment="Left" MaxWidth="760">
                    <StackPanel>
                        <TextBlock Text="Add new sprite" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Adds a new overworld sprite (e.g. a new person) to the game. Afterwards it can be selected when adding a person and in Porymap."/>

                        <TextBlock Text="1. Select and check image" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="Frame size:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding FrameSizes}" SelectedItem="{Binding FrameSize}" Width="90" Margin="0,0,8,0"/>
                            <Button Content="Select and check PNG…" Command="{Binding CheckCommand}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap"
                                   Text="Walking persons: 9 frames side by side (e.g. 144×32 for 16×32). At most 15 colors plus transparency."/>
                        <TextBlock Text="{Binding CheckReport}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Border Background="{DynamicResource BorderBrush}" HorizontalAlignment="Left" Padding="6" Margin="0,6,0,10">
                            <Image Source="{Binding CheckPreview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>

                        <TextBlock Text="2. Set name and palette" FontWeight="SemiBold"/>
                        <Grid Margin="0,4,0,10" IsEnabled="{Binding CanImport}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" AutomationProperties.Name="Sprite name"/>
                            <TextBlock Grid.Column="2" Text="{Binding ConstantPreview}" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,4"/>
                            <TextBlock Grid.Row="1" Text="Palette:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                <RadioButton Content="Use an existing palette" IsChecked="{Binding UseExistingPalette}" GroupName="pal"/>
                                <ComboBox ItemsSource="{Binding PaletteTags}" SelectedItem="{Binding PaletteTag}" IsEnabled="{Binding UseExistingPalette}" Margin="18,2,0,4"/>
                                <RadioButton Content="Create a new palette from the image's colors" IsChecked="{Binding UseNewPalette}" GroupName="pal"/>
                                <TextBox Text="{Binding NewPaletteName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseNewPalette}" Margin="18,2,0,0"
                                         AutomationProperties.Name="New palette name" ToolTip="Name of the new palette, e.g. Guard → OBJ_EVENT_PAL_TAG_GUARD"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,4"
                                       Text="{Binding PaletteHint}" TextWrapping="Wrap"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding AllowNearest}"
                                      Content="Replace missing colors with the closest palette color (shown beforehand)"/>
                        </Grid>

                        <TextBlock Text="3. Register in project" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Register in project…" Command="{Binding ImportCommand}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="480"
                                       Text="Shows all files that will be created or modified first. If anything fails, everything is rolled back."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </TabItem>

    <TabItem Header="Player character">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="All images of the player characters: walking, running, bikes, surfing, diving, field moves and item use, fishing, watering, decorating, and the battle pictures."/>
                <ListBox ItemsSource="{Binding PlayerGraphics}" SelectedItem="{Binding SelectedPlayer}" AutomationProperties.Name="Player images"/>
            </DockPanel>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedPlayer.Display}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding PlayerDetails}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource BorderBrush}" HorizontalAlignment="Left" Padding="6" Margin="0,8,0,8">
                        <Image Source="{Binding PlayerPreview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Replace image…" Command="{Binding ReplacePlayerCommand}" FontWeight="SemiBold"/>
                        <Button Content="Save a copy to edit…" Command="{Binding SavePlayerCopyCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="700" HorizontalAlignment="Left"
                               Text="Edit a saved copy in any paint program (same size, same frame layout), then replace. The frames are side by side in the order the game expects – keep that order. With &quot;new colors&quot; the shared palette changes for all of this character's overworld images."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </TabItem>

    <TabItem Header="Trainer pictures">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,8,0">
                <TextBox DockPanel.Dock="Top" Text="{Binding TrainerPicFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                         AutomationProperties.Name="Search trainer pictures"/>
                <Button DockPanel.Dock="Top" Content="Add new trainer picture…" Command="{Binding AddTrainerPicCommand}" HorizontalAlignment="Left" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <ListBox ItemsSource="{Binding TrainerPics}" SelectedItem="{Binding SelectedTrainerPic}" FontFamily="Consolas" FontSize="11"
                         VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Trainer pictures"/>
            </DockPanel>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedTrainerPic.Constant}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding TrainerPicDetails}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource BorderBrush}" HorizontalAlignment="Left" Padding="6" Margin="0,8,0,8">
                        <Image Source="{Binding TrainerPicPreview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Replace image…" Command="{Binding ReplaceTrainerPicCommand}"/>
                        <Button Content="Save a copy to edit…" Command="{Binding SaveTrainerPicCopyCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="700" HorizontalAlignment="Left"
                               Text="New trainer pictures: a 64×64 PNG with at most 15 colors plus a transparent background (the top-left pixel or alpha 0). The picture gets its own palette and can then be chosen as &quot;Picture&quot; in the Trainers module."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </TabItem>
    </TabControl>
</UserControl>