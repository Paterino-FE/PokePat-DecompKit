<UserControl x:Class="TilesetEditor.App.Modules.Mods.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Content="Add a mod folder…" Command="{Binding AddModCommand}"
                    ToolTip="Copies a mod (a folder with mod.json) into Documents\PokePat Mods."/>
            <Button Content="Open my mods folder" Command="{Binding OpenModsFolderCommand}"/>
        </WrapPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource WarnBannerBrush}" BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,6" Visibility="{Binding HasUpdates, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="⬆ Update all" Command="{Binding UpdateAllCommand}" FontWeight="SemiBold" Margin="8,0,0,0"
                        ToolTip="Updates every outdated mod; your settings, mugshots and pictures stay."/>
                <TextBlock Text="{Binding UpdatesText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource WarnTextBrush}" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Mods add features to your game (C code, script commands, data). PokePat checks first that every place it changes exists exactly once in your project, shows all files, makes a backup and can remove the mod again. Build the ROM after installing."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Mods">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource WarnBannerBrush}" BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="6,0" VerticalAlignment="Center" Visibility="{Binding CanUpdate, Converter={StaticResource BoolVis}}"
                                        ToolTip="A newer version of this mod is available – select it and press Update.">
                                    <TextBlock Text="{Binding UpdateBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarnTextBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock FontSize="11">
                                <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/><Run Text="  ·  "/><Run Text="{Binding State, Mode=OneWay}" Foreground="{Binding StateColor, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"><Run Text="Version "/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding State, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,8" FontSize="13"/>
                    <TextBlock Text="{Binding Problems}" TextWrapping="Wrap" Foreground="{DynamicResource AccentDarkBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="▶ Switch on…" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"
                                ToolTip="Adds the mod's code and files to your project (shown as a file list first)."/>
                        <Button Content="⬆ Update…" Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"
                                Visibility="{Binding CanUpdate, Converter={StaticResource BoolVis}}"
                                ToolTip="Switches the old version off and the new one on, and keeps your settings and pictures."/>
                        <Button Content="■ Switch off – restore the original…" Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="Removes everything the mod added: the changed files get back exactly the text they had before (vanilla)."/>
                    </StackPanel>
                    <TextBlock Text="How to use it" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Usage}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <TextBlock Text="What it changes" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Changes}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,12"/>
                    <!-- Settings of the installed mod (e.g. level caps) -->
                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding HasSettings, Converter={StaticResource BoolVis}}" Margin="0,0,0,12">
                        <TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Settings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="230" VerticalAlignment="Center"/>
                                        <TextBox DockPanel.Dock="Left" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                                 AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsText, Converter={StaticResource BoolVis}}"/>
                                        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" Width="200"
                                                  AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsChoice, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                    <!-- Content of the dialog portraits mod -->
                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding ShowPortraits, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Portraits" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="Add portrait from PNG…" Command="{Binding AddPortraitCommand}" FontWeight="SemiBold"
                                    ToolTip="Up to 64×64 pixels, at most 15 colors; transparent = alpha 0 or the top-left color."/>
                            <Button Content="From a trainer picture…" Command="{Binding AddTrainerPortraitCommand}"/>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Portraits}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,8" Padding="6" Background="{DynamicResource SurfaceBrush}" Width="150">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Width="128" Height="128" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <TextBlock Text="{Binding Constant}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Pictures (Emerald, mod version 1.1+) -->
                        <StackPanel Visibility="{Binding ShowPicturesSection, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Pictures" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding PicturesHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Add picture from PNG…" Command="{Binding AddPictureCommand}" FontWeight="SemiBold"
                                        ToolTip="Any size: bigger pictures are made smaller to fit 128×96; up to 15 colors are kept (fewer colors look better)."/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Pictures}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,8" Padding="6" Background="{DynamicResource SurfaceBrush}" Width="270">
                                            <StackPanel>
                                                <Image Source="{Binding Image}" Width="256" Height="192" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                <TextBlock Text="{Binding Constant}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
