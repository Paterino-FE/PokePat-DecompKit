<UserControl x:Class="TilesetEditor.App.Modules.Mods.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Content="Add a mod folder…" Command="{Binding AddModCommand}"
                    ToolTip="Copies a mod (a folder with mod.json) into Documents\PokePat Mods."/>
            <Button Content="Open my mods folder" Command="{Binding OpenModsFolderCommand}"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Mods add features to your game (C code, script commands, data). PokePat checks first that every place it changes exists exactly once in your project, shows all files, makes a backup and can remove the mod again. Build the ROM after installing."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Mods">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock FontSize="11">
                                <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/><Run Text="  ·  "/><Run Text="{Binding State, Mode=OneWay}" Foreground="{Binding StateColor, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"><Run Text="Version "/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding State, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,8" FontSize="13"/>
                    <TextBlock Text="{Binding Problems}" TextWrapping="Wrap" Foreground="{DynamicResource AccentDarkBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Install…" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"/>
                        <Button Content="Uninstall…" Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                    <TextBlock Text="How to use it" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Usage}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <TextBlock Text="What it changes" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Changes}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,12"/>
                    <!-- Content of the dialog portraits mod -->
                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding ShowPortraits, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Portraits" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="Add portrait from PNG…" Command="{Binding AddPortraitCommand}" FontWeight="SemiBold"
                                    ToolTip="Up to 64×64 pixels, at most 15 colors; transparent = alpha 0 or the top-left color."/>
                            <Button Content="From a trainer picture…" Command="{Binding AddTrainerPortraitCommand}"/>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Portraits}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,8" Padding="6" Background="{DynamicResource SurfaceBrush}" Width="150">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Width="128" Height="128" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <TextBlock Text="{Binding Constant}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
