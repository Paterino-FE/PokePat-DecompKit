<Window x:Class="TilesetEditor.App.Modules.Tilesets.ExportPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review export" Width="980" Height="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" x:Name="Header" Style="{StaticResource SectionTitle}"/>
        <TextBlock DockPanel.Dock="Top" x:Name="SubHeader" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ItemsControl x:Name="NotesList" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource Hint}"/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox x:Name="Confirm" Content="I have reviewed the list. Write the files now." Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" IsDefault="True" Click="OnApply" IsEnabled="{Binding IsChecked, ElementName=Confirm}"/>
                <Button Content="Cancel" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="Files" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="120"/>
                <DataGridTextColumn Header="File (relative to project)" Binding="{Binding RelativePath}" Width="430"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="70"/>
                <DataGridTextColumn Header="Content" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
