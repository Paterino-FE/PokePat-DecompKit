<UserControl x:Class="TilesetEditor.App.Modules.Tilesets.TilesetEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TilesetEditor.App.Controls"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <!-- One palette / color row: title + swatches -->
        <DataTemplate x:Key="PaletteRowTemplate">
            <StackPanel Margin="0,0,0,4">
                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                <ItemsControl ItemsSource="{Binding Colors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="16" Height="16" Margin="0,0,1,1" BorderBrush="#888" BorderThickness="1"
                                    Background="{Binding Brush}" ToolTip="{Binding Tooltip}" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.UseColorAsReplacementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="210"/>
        </Grid.RowDefinitions>

        <!-- Left: context, import, target -->
        <ScrollViewer Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
            <StackPanel>
                <GroupBox Header="1 · Primary tileset (context)">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding PrimaryTilesets}" SelectedItem="{Binding SelectedPrimary}" DisplayMemberPath="Name"/>
                        <TextBlock Text="{Binding PrimaryInfo}" Style="{StaticResource Hint}" Margin="0,4"/>
                        <ItemsControl ItemsSource="{Binding PrimaryPalettes}" ItemTemplate="{StaticResource PaletteRowTemplate}"/>
                        <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Hint}" FontSize="11"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Finished tileset">
                    <StackPanel>
                        <Button Content="Import finished tileset…" Command="{Binding ImportFinishedCommand}" FontWeight="SemiBold" Margin="0,0,0,4"
                                ToolTip="A folder with a tiles PNG, palettes and metatiles (asset repos, other hacks): add it as a new tileset or replace one, and use it on maps."/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap"
                                   Text="Or drag the tileset's folder onto this page. To build a new tileset from your own images, use the steps below."/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Edit or create as images">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="PokePat puts the layers (bottom, middle, top) as PNGs into a folder. Paint in Aseprite, Paint.NET … and save – PokePat reloads and rebuilds the preview by itself."/>
                        <ComboBox ItemsSource="{Binding SecondaryTilesets}" SelectedItem="{Binding EditTarget}" IsTextSearchEnabled="True" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <Button Content="Edit as images…" Command="{Binding EditExistingCommand}" Margin="0,0,6,4"
                                    ToolTip="Exporting afterwards replaces this tileset in place – same metatile order, behaviors (grass, water …) kept."/>
                            <Button Content="New blank tileset…" Command="{Binding NewBlankCommand}" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <StackPanel Visibility="{Binding HasWorkFolder, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding WorkFolder}" Style="{StaticResource Hint}" FontSize="10" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="Open folder" Command="{Binding OpenWorkFolderCommand}" Margin="0,2,6,0"/>
                                <CheckBox Content="Rebuild when saved" IsChecked="{Binding AutoRebuild}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="2 · Import PNG">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}" Padding="8" Margin="0,0,0,6">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                       Text="Drag PNGs here. One file = one layer; 2–3 files = layers (names containing bottom/middle/top or unten/mitte/oben)."/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Single image as layer:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding AllLayers}" SelectedItem="{Binding SingleImageLayer}" Width="90"/>
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="Open PNG…" Command="{Binding OpenImageCommand}" Margin="0,0,6,4"/>
                            <Button Content="Layer PNGs…" Command="{Binding OpenLayersCommand}" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding LayerModeText}" Style="{StaticResource Hint}" FontSize="11"/>
                        <TextBlock Text="{Binding ImportSummary}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="3 · New secondary tileset">
                    <StackPanel>
                        <TextBox Text="{Binding TilesetName, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding FolderPreview}" Style="{StaticResource Hint}" FontSize="11"/>
                        <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                        <CheckBox Content="Also store RGBA source layers" IsChecked="{Binding IncludeSources}" Margin="0,4"
                                  ToolTip="Stores the imported layers and a manifest in &lt;Tileset&gt;/tileset_editor/ (for later changes; not part of the build)."/>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Compile (Porytiles)" Command="{Binding CompileCommand}" FontWeight="SemiBold" Margin="0,0,6,4"/>
                            <Button Content="Cancel" Command="{Binding CancelCompileCommand}" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsCompiling, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding CompileStatus}" Style="{StaticResource Hint}" Margin="0,4"/>
                        <Button Content="Export…" Command="{Binding ExportCommand}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Center: previews -->
        <DockPanel Grid.Column="1" Grid.Row="0">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider Minimum="1" Maximum="12" Value="{Binding Zoom}" Width="110" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"/>
                <TextBlock Text="{Binding Zoom, StringFormat={}{0}×}" VerticalAlignment="Center" Width="30" Margin="4,0,10,0"/>
                <CheckBox Content="8×8 grid" IsChecked="{Binding ShowTileGrid}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Layers:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <CheckBox Content="Bottom" IsChecked="{Binding ShowBottom}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <CheckBox Content="Middle" IsChecked="{Binding ShowMiddle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <CheckBox Content="Top" IsChecked="{Binding ShowTop}" VerticalAlignment="Center"/>
            </WrapPanel>
            <TabControl SelectedIndex="{Binding SelectedTab}">
                <TabItem Header="Import (original colors)">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BorderBrush}">
                        <c:PixelCanvas Image="{Binding PreviewImage}" Zoom="{Binding Zoom}" ShowTileGrid="{Binding ShowTileGrid}"
                                       Markers="{Binding Markers}" SelectedTile="{Binding SelectedTile}" TileClickCommand="{Binding TileClickCommand}"
                                       Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Compiled (GBA colors)">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BorderBrush}">
                            <c:PixelCanvas Image="{Binding CompiledImage}" Zoom="{Binding Zoom}" ShowTileGrid="{Binding ShowTileGrid}"
                                           Markers="{Binding Markers}" SelectedTile="{Binding SelectedTile}" TileClickCommand="{Binding TileClickCommand}"
                                           Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <TextBlock Text="No compiled output yet. Run &quot;Compile (Porytiles)&quot;." Margin="16"
                                   Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CompiledImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Right: selection and colors -->
        <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
            <StackPanel>
                <GroupBox Header="Selection">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectionTitle}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding SelectedTileColors}" ItemTemplate="{StaticResource PaletteRowTemplate}"/>
                        <TextBlock Text="{Binding CompiledTileInfo}" Style="{StaticResource Hint}" Margin="0,4"/>
                        <ItemsControl ItemsSource="{Binding CompiledTilePalettes}" ItemTemplate="{StaticResource PaletteRowTemplate}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Map / replace colors">
                    <StackPanel>
                        <TextBlock Text="{Binding ColorSummary}" Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding ColorUsages}" SelectedItem="{Binding SelectedColor}" Height="170">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" Background="{Binding Brush}" BorderBrush="#888" BorderThickness="1" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Replace with (#RRGGBB or click a swatch):" Margin="0,4,0,2" FontSize="11"/>
                        <DockPanel>
                            <Button Content="Replace" Command="{Binding ReplaceColorCommand}" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding ReplacementText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Round to GBA colors" Command="{Binding SnapGbaCommand}" Margin="0,0,6,4"/>
                            <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" FontSize="11"
                                   Text="Changes that merge colors are only applied after confirmation. The source file stays unchanged."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>

        <!-- Bottom: issues and log -->
        <TabControl Grid.Row="2" Grid.ColumnSpan="3" Margin="0,4,0,0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Problems  "/>
                        <TextBlock Text="{Binding IssueSummary}" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding SeverityText}" Width="70"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="85"/>
                        <DataGridTextColumn Header="Position" Binding="{Binding Location, Converter={x:Static c:IssueLocationConverter.Instance}}" Width="260"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Log">
                <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="OnLogChanged"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
