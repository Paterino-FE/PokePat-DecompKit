<UserControl x:Class="TilesetEditor.App.Modules.Maps.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Name, layout, tileset or group"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,0,0,2"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding PorymapHint}" Foreground="{DynamicResource AccentDarkBrush}" Margin="0,0,0,4"/>
            <DataGrid ItemsSource="{Binding Maps}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" EnableRowVirtualization="True"
                      ToolTip="Double-click: open the map in Porymap">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenInPorymapCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Map" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="170"/>
                    <DataGridTextColumn Header="Layout" Binding="{Binding LayoutId}" Width="200"/>
                    <DataGridTextColumn Header="Primary" Binding="{Binding PrimaryTileset}" Width="140"/>
                    <DataGridTextColumn Header="Secondary" Binding="{Binding SecondaryTileset}" Width="170"/>
                    <DataGridTextColumn Header="Events" Binding="{Binding EventCount}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
            <StackPanel>
                <TextBlock Text="Map" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="#20242A" MaxHeight="420" HorizontalAlignment="Left"
                        Visibility="{Binding HasPreview, Converter={StaticResource BoolVis}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image Source="{Binding Preview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </ScrollViewer>
                </Border>
                <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Hint}" Margin="0,2,0,8"/>
                <TextBlock Text="Details" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Details}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Change tilesets…" Command="{Binding ChangeTilesetsCommand}" Margin="0,0,6,4"
                            ToolTip="Use another primary or secondary tileset on this map (e.g. one imported in the Tilesets module)."/>
                    <Button Content="Open in Porymap" Command="{Binding OpenInPorymapCommand}" Margin="0,0,6,4"
                            ToolTip="Points Porymap at this project and map, then starts it (Porymap must be closed)."/>
                    <Button Content="New secondary tileset for this map…" Command="{Binding NewTilesetCommand}" Margin="0,0,6,4"
                            ToolTip="Opens the tileset editor with this map's primary tileset. Assigning it to the map is done afterwards in Porymap."/>
                    <Button Content="Open map folder" Command="{Binding OpenFolderCommand}" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock Text="Connections and warps (click = show map)" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Links}" Margin="0,2,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,1">
                                <Hyperlink Command="{Binding DataContext.FollowLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"><Run Text="{Binding Text, Mode=OneWay}"/></Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Scripts (files and labels used by events)" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Scripts}" Margin="0,2,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,1" FontFamily="Consolas" FontSize="11">
                                <Hyperlink Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"><Run Text="{Binding Mode=OneWay}"/></Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding ScriptLabels}" Margin="12,0,0,8" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="Tileset usage" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding TilesetUsage}" Margin="0,2,0,8" FontFamily="Consolas" FontSize="11"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="11"
                           Text="Maps and layouts are created and edited in Porymap. This view only reads them and refreshes when Porymap saves."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
