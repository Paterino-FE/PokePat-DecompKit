<UserControl x:Class="TilesetEditor.App.Modules.SecretBases.SecretBasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChangedRowBrush}" BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6"
                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
            <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Problems}" TextWrapping="Wrap" FontSize="11"/>
            </ScrollViewer>
        </Border>
        <TabControl>
            <!-- ============================================================ Locations -->
            <TabItem Header="Locations">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding LocationFilter, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,10,0"
                                     AutomationProperties.Name="Search locations" ToolTip="Map, id or type"/>
                            <CheckBox Content="Only with warnings" IsChecked="{Binding OnlyWarnings}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="New secret base location…" Command="{Binding NewLocationCommand}" FontWeight="SemiBold"/>
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                                  AutomationProperties.Name="Secret base locations">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Map" Binding="{Binding MapFolder}" Width="120"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="35"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="35"/>
                                <DataGridTextColumn Header="Id constant" Binding="{Binding IdConstant}" Width="210" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Id" Binding="{Binding IdText}" Width="40"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                                <DataGridTextColumn Header="Interior" Binding="{Binding Interior}" Width="140"/>
                                <DataGridTextColumn Header="Outside tile" Binding="{Binding MetatileText}" Width="70" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
                    <DockPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding LocationDetails}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding Zooms}" SelectedIndex="{Binding ZoomIndex}" Width="60"/>
                            <TextBlock Text="  red = this entrance, orange = other secret bases on the map" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource InkBrush}">
                            <ScrollViewer x:Name="LocationScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image Source="{Binding LocationPreview}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                                    </Image.LayoutTransform>
                                </Image>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ Interiors -->
            <TabItem Header="Interiors">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Each interior (group) is one map in the secret base map group. Its id constants are group × 10 + 1…9; every location that uses one of them opens this map."/>
                        <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutomationProperties.Name="Interiors"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
                    <DockPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding InteriorDetails}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding Zooms}" SelectedIndex="{Binding ZoomIndex}" Width="60"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource InkBrush}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image Source="{Binding InteriorPreview}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                                    </Image.LayoutTransform>
                                </Image>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ Decorations -->
            <TabItem Header="Decorations">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding DecorationFilter, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,10,0"
                                     AutomationProperties.Name="Search decorations" ToolTip="Constant, name, category or graphics"/>
                            <Button Content="New doll / cushion…" Command="{Binding NewDecorationCommand}" FontWeight="SemiBold"/>
                            <Button Content="Add missing icon entries…" Command="{Binding FixIconTableCommand}" Margin="8,0,0,0"
                                    ToolTip="Adds {NULL, NULL} to gDecorIconTable for decorations without an entry"/>
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding DecorationRows}" SelectedItem="{Binding SelectedDecoration}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                                  EnableRowVirtualization="True" AutomationProperties.Name="Decorations">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Icon}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="35"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="55"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="75"/>
                                <DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="45"/>
                                <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="95"/>
                                <DataGridTextColumn Header="Graphics" Binding="{Binding Graphics}" Width="140"/>
                                <DataGridTextColumn Header="Icon" Binding="{Binding IconSource}" Width="90"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
                    <ScrollViewer Grid.Column="2" Margin="6,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDecoration.Constant}" Style="{StaticResource SectionTitle}"/>
                            <Image Source="{Binding DecorationPreview}" Stretch="None" HorizontalAlignment="Left" Margin="0,0,0,6"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <TextBlock Text="{Binding DecorationDetails}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                            <TextBlock Text="Name (max. 15 characters)" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Decoration name" Margin="0,2,0,6"/>
                            <TextBlock Text="Price" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Decoration price" Margin="0,2,0,6"/>
                            <TextBlock Text="Description (max. 3 lines)" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64"
                                     AutomationProperties.Name="Decoration description" Margin="0,2,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save…" Command="{Binding SaveDecorationCommand}" FontWeight="SemiBold" MinWidth="80"/>
                                <Button Content="Discard" Command="{Binding ResetDecorationCommand}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Category, shape and graphics are read-only here: changing the shape or permission of an existing decoration would break decorations already placed in save files."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
