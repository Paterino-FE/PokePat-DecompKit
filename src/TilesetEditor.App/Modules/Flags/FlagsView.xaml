<UserControl x:Class="TilesetEditor.App.Modules.Flags.FlagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,12,0"
                     AutomationProperties.Name="Search flags" ToolTip="Name, value or description"/>
            <TextBlock Text="Map:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Maps}" SelectedItem="{Binding Map}" Width="210" Margin="0,0,12,0" IsTextSearchEnabled="True"
                      AutomationProperties.Name="Map filter"/>
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="140" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="190" Margin="0,0,8,0"/>
            <CheckBox Content="Only used ones" IsChecked="{Binding OnlyUsed}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="New flag…" Command="{Binding NewFlagCommand}" FontWeight="SemiBold"/>
            <Button Content="New variable…" Command="{Binding NewVarCommand}"/>
            <Button Content="More flags…" Command="{Binding MoreFlagsCommand}" Margin="12,0,0,0"
                    ToolTip="Adds 64 new free saved flags when all free ones are used (save-breaking)"/>
            <Button Content="More variables…" Command="{Binding MoreVarsCommand}"
                    ToolTip="Adds 16 new free saved variables when all free ones are used (save-breaking)"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" EnableRowVirtualization="True"
                      AutomationProperties.Name="Flags">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="270" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Hex}" Width="70" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                    <DataGridTextColumn Header="Uses" Binding="{Binding Usages}" Width="45"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Comment}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Details" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    <DockPanel Margin="0,6,0,4">
                        <Button DockPanel.Dock="Right" Content="Save description…" Command="{Binding SaveCommentCommand}" Margin="6,0,0,0"/>
                        <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Flag description"
                                 ToolTip="Comment at the end of the #define line"/>
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open file" Command="{Binding OpenUsageCommand}"/>
                        <TextBlock Text="Used in" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedUsages}" SelectedItem="{Binding SelectedUsage}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,4,0,0" AutomationProperties.Name="Flag uses">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Map" Binding="{Binding Map}" Width="130"/>
                        <DataGridTextColumn Header="Does" Binding="{Binding KindText}" Width="90"/>
                        <DataGridTextColumn Header="Line" Binding="{Binding Text}" Width="*" FontFamily="Consolas"/>
                        <DataGridTextColumn Header="File" Binding="{Binding File}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="2" Margin="0,10,0,4">
                    <Button DockPanel.Dock="Right" Content="Discard" Command="{Binding ResetObjectsCommand}" Margin="4,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Save visibility…" Command="{Binding SaveObjectsCommand}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ObjectsTitle}" Style="{StaticResource SectionTitle}" Margin="0"/>
                </DockPanel>
                <DataGrid Grid.Row="3" ItemsSource="{Binding Objects}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutomationProperties.Name="Persons on map">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChanged}" Value="True"><Setter Property="Background" Value="{DynamicResource ChangedRowBrush}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Person" Binding="{Binding Person, Mode=OneWay}" Width="170" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Hidden while flag is set" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" Text="{Binding Flag, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                                              ItemsSource="{Binding DataContext.FlagNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              VirtualizingPanel.IsVirtualizing="True">
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Script" Binding="{Binding Script, Mode=OneWay}" Width="150" IsReadOnly="True" FontFamily="Consolas"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
