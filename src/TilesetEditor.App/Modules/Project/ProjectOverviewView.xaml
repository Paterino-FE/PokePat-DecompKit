<UserControl x:Class="TilesetEditor.App.Modules.Project.ProjectOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Project" Style="{StaticResource SectionTitle}"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" Padding="10" Margin="0,0,0,12">
                <TextBlock Text="{Binding Facts}" FontFamily="Consolas" TextWrapping="Wrap"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Go to tileset editor →" Command="{Binding OpenTilesetsCommand}" FontWeight="SemiBold"/>
            </StackPanel>

            <TextBlock Text="Tools for this project" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,3"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Width" Value="140"/></Style>
                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="Porymap (porymap.exe)"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PorymapExe, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="…" Command="{Binding BrowsePorymapCommand}" Margin="6,0,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PorymapStatus}" Style="{StaticResource Hint}" FontSize="11"/>

                <TextBlock Grid.Row="2" Text="Build environment"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding BuildEnvironments}" SelectedItem="{Binding BuildEnv}"/>
                    <TextBlock Text="  WSL distribution:" Margin="6,0"/>
                    <TextBox Text="{Binding BuildDistro, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Build command"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BuildCommand, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Runs in the project folder (WSL: bash -lc, Windows: cmd /c). Example: make -j$(nproc)"/>
                <TextBlock Grid.Row="4" Text="ROM file (relative)"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RomPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Empty = derived from FILE_NAME in the Makefile (e.g. pokeemerald.gba)"/>

                <TextBlock Grid.Row="5" Text="Emulator (optional)"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EmulatorExe, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="5" Grid.Column="2" Content="…" Command="{Binding BrowseEmulatorCommand}" Margin="6,0,0,0"/>

                <TextBlock Grid.Row="6" Text="Porytiles"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding PorytilesModes}" SelectedItem="{Binding PorytilesMode}"/>
                    <TextBlock Text="  WSL distribution:" Margin="6,0"/>
                    <TextBox Text="{Binding PorytilesDistro, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                </StackPanel>
                <TextBlock Grid.Row="7" Text="Porytiles executable"/>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding PorytilesExe, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="WSL: Linux path (~ allowed). Native: Windows path to porytiles.exe"/>
                <Button Grid.Row="7" Grid.Column="2" Content="Check" Command="{Binding CheckPorytilesCommand}" Margin="6,0,0,0"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PorytilesStatus}" Style="{StaticResource Hint}" FontSize="11"/>

                <TextBlock Grid.Row="10" Text="Porymap bridge" VerticalAlignment="Top" Margin="0,14,0,0"/>
                <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,14,0,0">
                    <TextBlock Text="{Binding BridgeStatus}" Style="{StaticResource Hint}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Set up…" Command="{Binding InstallBridgeCommand}"/>
                        <Button Content="Remove…" Command="{Binding UninstallBridgeCommand}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save settings" Command="{Binding SaveCommand}"/>
                    <TextBlock Text="{Binding SaveHint}" Foreground="#B45309" Margin="8,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
