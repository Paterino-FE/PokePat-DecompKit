<UserControl x:Class="TilesetEditor.App.Modules.Features.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <CollectionViewSource x:Key="Grouped" Source="{Binding Options}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupTitle"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,12,0"
                     ToolTip="Name, value, section or description" AutomationProperties.Name="Search features"/>
            <TextBlock Text="Kind:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="110" Margin="0,0,12,0"/>
            <Button Content="Save changes…" Command="{Binding SaveCommand}" FontWeight="SemiBold"/>
            <Button Content="Discard" Command="{Binding ResetCommand}"/>
            <Button Content="Show in Explorer" Command="{Binding ShowInExplorerCommand}"/>
            <Button Content="Copy" Command="{Binding CopyCommand}"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0"
                   Text="Values come directly from include/config/*.h of the open branch. On/off switches are only offered where the branch defines TRUE/FALSE. &quot;Conditional&quot; = inside #if – these options are read-only because the effective value may differ. Changed rows are highlighted in yellow."/>
        <DockPanel DockPanel.Dock="Left" Width="210" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="Categories" Style="{StaticResource SectionTitle}"/>
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Feature categories"/>
        </DockPanel>
        <DataGrid ItemsSource="{Binding Source={StaticResource Grouped}}" VirtualizingPanel.IsVirtualizingWhenGrouping="True" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" EnableRowVirtualization="True">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Expander IsExpanded="True" Margin="0,2,0,0">
                                            <Expander.Header>
                                                <TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ·  " Foreground="#B3A3A0"/><Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="#7D6B69"/></TextBlock>
                                            </Expander.Header>
                                            <ItemsPresenter/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChanged}" Value="True"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="290" FontFamily="Consolas" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Value" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <CheckBox IsChecked="{Binding IsOn, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Value}" FontFamily="Consolas"
                                          Visibility="{Binding IsSwitch, Converter={StaticResource BoolVis}}"/>
                                <ComboBox ItemsSource="{Binding Generations}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                          Visibility="{Binding IsGeneration, Converter={StaticResource BoolVis}}"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                                         Visibility="{Binding IsNumber, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding Value}" FontFamily="Consolas" Foreground="#6B5B59"
                                           Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Kind" Binding="{Binding KindText, Mode=OneWay}" Width="85" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Conditional" Binding="{Binding Conditional, Mode=OneWay}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Source" Binding="{Binding File, Mode=OneWay}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Line" Binding="{Binding Line, Mode=OneWay}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=OneWay}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
