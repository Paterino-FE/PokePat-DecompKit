<Window Icon="pack://application:,,,/Assets/decompkit.ico" x:Class="TilesetEditor.App.Modules.Events.NewPersonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New on map" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="Header" Style="{StaticResource SectionTitle}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,4"/></Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,4"/></Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,4"/></Style>
            </Grid.Resources>
            <TextBlock x:Name="GraphicsLabel" Text="Appearance (sprite)"/>
            <ComboBox x:Name="Graphics" Grid.Column="1" IsEditable="True" AutomationProperties.Name="Sprite">
                <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Position X / Y"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="X" Width="60" AutomationProperties.Name="X"/>
                <TextBlock Text="  /  "/>
                <TextBox x:Name="Y" Width="60" AutomationProperties.Name="Y"/>
                <TextBlock x:Name="SizeInfo" Foreground="{DynamicResource MutedBrush}" Margin="10,4,0,4"/>
            </StackPanel>
            <TextBlock x:Name="MovementLabel" Grid.Row="2" Text="Movement"/>
            <ComboBox x:Name="Movement" Grid.Column="1" Grid.Row="2" IsEditable="True" AutomationProperties.Name="Movement">
                <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
            </ComboBox>
            <TextBlock Grid.Row="3" Text="Elevation"/>
            <TextBox x:Name="Elevation" Grid.Column="1" Grid.Row="3" Width="60" HorizontalAlignment="Left" Text="3"/>
            <TextBlock Grid.Row="4" Text="Event"/>
            <CheckBox x:Name="AssignEvent" Grid.Column="1" Grid.Row="4" VerticalAlignment="Center"/>
            <TextBlock x:Name="VarLabel" Grid.Row="5" Text="Trigger when"/>
            <StackPanel x:Name="VarPanel" Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="VarName" Width="220" IsEditable="True" AutomationProperties.Name="Variable">
                    <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                </ComboBox>
                <TextBlock Text="  =  "/>
                <TextBox x:Name="VarValue" Width="50" Text="0" AutomationProperties.Name="Value"/>
            </StackPanel>
            <TextBlock x:Name="Error" Grid.Row="6" Grid.ColumnSpan="2" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
        </Grid>
        <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0"
                   x:Name="Info" Text="The entry is appended to the end of the matching list in map.json (like Porymap does). The toolkit shows the file change before writing."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Next…" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
