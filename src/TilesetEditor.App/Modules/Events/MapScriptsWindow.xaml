<Window Icon="pack://application:,,,/Assets/decompkit.ico" x:Class="TilesetEditor.App.Modules.Events.MapScriptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Existing scripts" Width="1100" Height="700" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" x:Name="Header" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock DockPanel.Dock="Top" x:Name="Note" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,6"
                   Text="Read-only view of the map's hand-written scripts. Movements are shown as steps; click a line with → to jump to its label. Use this as a model for your own events (e.g. the block &quot;Move together (scene)&quot;)."/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <CheckBox x:Name="ShowScripts" Content="Scripts" IsChecked="True" Margin="0,0,10,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox x:Name="ShowMovements" Content="Movements" IsChecked="True" Margin="0,0,10,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox x:Name="ShowTexts" Content="Texts" IsChecked="False" Margin="0,0,10,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <Button Content="Open file" Click="OpenFile" Margin="12,0,0,0"/>
            <Button x:Name="ShowOnMapButton" Content="🗺 Show movements on map…" Click="ShowOnMap" IsEnabled="False"
                    ToolTip="Draws the map with every person and the walking paths of the selected script. Movements up to each waitmovement run at the same time."/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Labels" SelectionChanged="LabelChanged" AutomationProperties.Name="Script labels">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,1">
                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}">
                                <Run Text="{Binding KindText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding UsedByText, Mode=OneWay}" Foreground="{DynamicResource AccentDarkBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <ListBox Grid.Column="2" x:Name="Lines" MouseDoubleClick="LineActivated" KeyDown="LineKey" AutomationProperties.Name="Script lines"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel ToolTip="{Binding Raw}">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Width="24"/>
                            <TextBlock DockPanel.Dock="Right" Text="→" Foreground="{DynamicResource AccentDarkBrush}" FontWeight="Bold" Margin="6,0,0,0"
                                       Visibility="{Binding JumpVisibility}"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
