<Window x:Class="TilesetEditor.App.Modules.Events.DialogPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1080" Height="620" WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}"
        KeyDown="OnKey">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Right" Width="300" Margin="12,0,0,0">
            <TextBlock Text="Window" FontWeight="SemiBold"/>
            <ComboBox x:Name="FrameChoice" SelectionChanged="OnOptionChanged" Margin="0,2,0,4"/>
            <Button Content="Load custom window PNG…" Click="OnLoadCustomFrame" HorizontalAlignment="Left"
                    ToolTip="56×16 pixels (layout like message_box.png) or 24×24 pixels (layout like text_window/1.png), indexed"/>
            <TextBlock x:Name="CustomInfo" Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,8"/>

            <TextBlock Text="Text speed" FontWeight="SemiBold"/>
            <ComboBox x:Name="SpeedChoice" SelectionChanged="OnOptionChanged" Margin="0,2,0,8">
                <ComboBoxItem Content="Slow (8 frames/character)" Tag="8"/>
                <ComboBoxItem Content="Medium (4 frames/character)" Tag="4" IsSelected="True"/>
                <ComboBoxItem Content="Fast (1 frame/character)" Tag="1"/>
            </ComboBox>

            <TextBlock Text="Player name ({PLAYER})" FontWeight="SemiBold"/>
            <TextBox x:Name="PlayerName" Text="PLAYER" Margin="0,2,0,8"/>

            <TextBlock Text="Flags at start" FontWeight="SemiBold"/>
            <ItemsControl x:Name="FlagList" Margin="0,2,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSet}" FontFamily="Consolas" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="↻ Restart" Click="OnRestart" HorizontalAlignment="Left" Margin="0,0,0,8"/>

            <TextBlock Text="Log" FontWeight="SemiBold"/>
            <ListBox x:Name="LogList" Height="140" FontSize="11"/>
        </StackPanel>

        <StackPanel>
            <Border BorderBrush="#111827" BorderThickness="6" CornerRadius="6" HorizontalAlignment="Left" Background="Black">
                <Image x:Name="Screen" Width="720" Height="480" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonDown="OnScreenClick"
                       Cursor="Hand"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="AButton" Content="A  (Enter / Space / click)" Click="OnA" FontWeight="SemiBold"/>
                <Button x:Name="YesButton" Content="YES" Click="OnYes" Width="60"/>
                <Button x:Name="NoButton" Content="NO" Click="OnNo" Width="60"/>
                <Button x:Name="BButton" Content="B (Esc)" Click="OnB" Width="70"/>
                <TextBlock x:Name="StateText" VerticalAlignment="Center" Margin="10,0" Foreground="#3B2F2F"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0"
                       Text="Rendered with the project's font, character widths, text colors and window graphics (3× zoom). Arrow keys ↑/↓ pick YES/NO or menu items, Esc = B (cancel)."/>
        </StackPanel>
    </DockPanel>
</Window>
