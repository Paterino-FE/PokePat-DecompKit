<Window Icon="pack://application:,,,/Assets/decompkit.ico" x:Class="TilesetEditor.App.Modules.Events.MovementPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ev="clr-namespace:TilesetEditor.App.Modules.Events"
        Title="Movements on the map" Width="1200" Height="780" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" x:Name="Header" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Top" x:Name="SubHeader" Style="{StaticResource Hint}" Margin="0,2,0,6"/>

        <!-- Right: settings, legend, warnings -->
        <ScrollViewer DockPanel.Dock="Right" Width="340" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Player start" FontWeight="SemiBold"/>
                <TextBlock x:Name="PlayerInfo" Margin="0,2,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Facing:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PlayerFacing" Width="90" SelectionChanged="OnPlayerFacingChanged"/>
                    <Button Content="Reset" Click="OnResetPlayer" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,8"
                           Text="The player has no fixed place: click the map to set where the player stands when the event starts."/>

                <TextBlock Text="Play-through" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <Button x:Name="PlayButton" Content="▶ Play" Click="OnPlay" FontWeight="SemiBold"/>
                    <Button Content="⏮ Start" Click="OnRewind"/>
                    <ComboBox x:Name="SpeedChoice" Width="80" SelectedIndex="1">
                        <ComboBoxItem Content="½× speed" Tag="0.5"/>
                        <ComboBoxItem Content="1× speed" Tag="1"/>
                        <ComboBoxItem Content="2× speed" Tag="2"/>
                    </ComboBox>
                </StackPanel>
                <Slider x:Name="TimeSlider" Minimum="0" Maximum="1" ValueChanged="OnTimeChanged" Margin="0,2,0,0"/>
                <TextBlock x:Name="TimeText" Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,8"/>

                <TextBlock Text="View" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ZoomChoice" Width="70" SelectionChanged="OnZoomChanged"/>
                </StackPanel>
                <CheckBox x:Name="ShowPeople" Content="Show all persons of the map" IsChecked="True" Checked="OnViewChanged" Unchecked="OnViewChanged"/>
                <CheckBox x:Name="ShowNumbers" Content="Show step numbers" IsChecked="True" Checked="OnViewChanged" Unchecked="OnViewChanged"/>
                <CheckBox x:Name="ShowBlocked" Content="Mark blocked tiles (collision)" IsChecked="False" Checked="OnViewChanged" Unchecked="OnViewChanged"
                          Margin="0,0,0,8"/>

                <TextBlock Text="Who moves" FontWeight="SemiBold"/>
                <StackPanel x:Name="Legend" Margin="0,2,0,8"/>

                <TextBlock Text="Warnings" FontWeight="SemiBold"/>
                <StackPanel x:Name="WarningList" Margin="0,2,0,8"/>

                <TextBlock Style="{StaticResource Hint}" FontSize="11"
                           Text="Approximate: durations are estimated per step type (walk 16 frames, slow 32, run 8 …). Persons are drawn where map.json places them; scripts that move them earlier are not taken into account. Ctrl + mouse wheel zooms."/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" x:Name="HoverText" Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,0"/>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource InkBrush}">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnWheel">
                    <ev:MapDrawingSurface x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Cross"
                                          MouseLeftButtonDown="OnMapClick" MouseMove="OnMapMove"/>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
