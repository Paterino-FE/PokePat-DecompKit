<UserControl x:Class="TilesetEditor.App.Modules.Trainers.TrainersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <ItemsPanelTemplate x:Key="VPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="ItemsPanel" Value="{StaticResource VPanel}"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#6B5B59"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,8,0">
            <TextBox DockPanel.Dock="Top" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                     AutomationProperties.Name="Search trainers" ToolTip="Constant, name, class or Pokémon"/>
            <Button DockPanel.Dock="Top" Content="New trainer…" Command="{Binding NewTrainerCommand}" Margin="0,0,0,4" HorizontalAlignment="Left"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding Trainers}" SelectedItem="{Binding Selected}" VirtualizingPanel.IsVirtualizing="True"
                     AutomationProperties.Name="Trainer list">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,1">
                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Title}" FontSize="11"/>
                            <TextBlock Text="{Binding Party}" FontSize="10" Foreground="#7D6B69" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1" Visibility="{Binding HasTrainer, Converter={StaticResource BoolVis}}">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Discard" Command="{Binding DiscardCommand}" Margin="4,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Save trainer…" Command="{Binding SaveCommand}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Editing.Id}" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="4" Background="#F6ECE8" Width="72" Height="72" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Image Source="{Binding PicPreview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,1"
                                 AutomationProperties.Name="Trainer name" ToolTip="Shown in battle, max. 10 characters"/>
                        <TextBlock Grid.Column="3" Text="Class" Style="{StaticResource Lbl}" Margin="12,0,6,0"/>
                        <ComboBox Grid.Column="4" Style="{StaticResource Pick}" ItemsSource="{Binding Symbols.Classes}" Text="{Binding TrainerClass, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Picture" Style="{StaticResource Lbl}"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Pick}" ItemsSource="{Binding Symbols.Pics}" Text="{Binding Pic, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Music" Style="{StaticResource Lbl}" Margin="12,0,6,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Pick}" ItemsSource="{Binding Symbols.Music}" Text="{Binding Music, UpdateSourceTrigger=LostFocus}"
                                  ToolTip="Encounter music; may include F_TRAINER_FEMALE | …"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Items" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Items, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontSize="11" Margin="0,1"
                                 ToolTip="Items the trainer uses in battle, comma separated (max. 4), e.g. ITEM_POTION, ITEM_POTION"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="AI flags" Style="{StaticResource Lbl}" Margin="12,0,6,0"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding AiFlags, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontSize="11" Margin="0,1"
                                 ToolTip="e.g. AI_FLAG_BASIC_TRAINER or AI_FLAG_SMART_TRAINER (combine with |)"/>
                        <CheckBox Grid.Row="3" Grid.Column="2" Content="Double battle" IsChecked="{Binding DoubleBattle}" Margin="0,4,0,0"/>
                    </Grid>

                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="+ Add Pokémon" Command="{Binding AddMonCommand}"/>
                        <TextBlock Text="Party" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Party}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EBD9D4" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,8,8" Width="330" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Border Background="#FFF8F2" Width="64" Height="64">
                                                <Image Source="{Binding Preview}" Stretch="None"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="◀" Command="{Binding UpCommand}" ToolTip="Move left" Padding="4,0" MinWidth="0"/>
                                                <Button Content="▶" Command="{Binding DownCommand}" ToolTip="Move right" Padding="4,0" MinWidth="0" Margin="2,0"/>
                                                <Button Content="✕" Command="{Binding RemoveCommand}" ToolTip="Remove from party" Padding="4,0" MinWidth="0"/>
                                            </StackPanel>
                                            <CheckBox Content="Shiny" IsChecked="{Binding IsShiny}" Margin="0,4,0,0" FontSize="11"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Species" Style="{StaticResource Lbl}"/>
                                            <ComboBox Grid.Column="1" Style="{StaticResource Pick}" ItemsSource="{Binding Owner.SpeciesList}" Text="{Binding Species, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Row="1" Text="Level" Style="{StaticResource Lbl}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Level, UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" Margin="0,1"/>
                                            <TextBlock Grid.Row="2" Text="Item" Style="{StaticResource Lbl}"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Pick}" ItemsSource="{Binding Owner.ItemList}" Text="{Binding HeldItem, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Row="3" Text="Ability" Style="{StaticResource Lbl}"/>
                                            <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Pick}" ItemsSource="{Binding Owner.AbilityList}" Text="{Binding Ability, UpdateSourceTrigger=LostFocus}"
                                                      ToolTip="Empty = the species' default ability"/>
                                            <TextBlock Grid.Row="4" Text="Nature" Style="{StaticResource Lbl}"/>
                                            <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Pick}" ItemsSource="{Binding Owner.Symbols.Natures}" Text="{Binding Nature, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Row="5" Text="Moves" Style="{StaticResource Lbl}" VerticalAlignment="Top" Margin="0,4,6,0"/>
                                            <StackPanel Grid.Row="5" Grid.Column="1" ToolTip="Empty = moves learned by level-up">
                                                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding Owner.MoveList}" Text="{Binding Move1, UpdateSourceTrigger=LostFocus}"/>
                                                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding Owner.MoveList}" Text="{Binding Move2, UpdateSourceTrigger=LostFocus}"/>
                                                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding Owner.MoveList}" Text="{Binding Move3, UpdateSourceTrigger=LostFocus}"/>
                                                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding Owner.MoveList}" Text="{Binding Move4, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="6" Text="IVs" Style="{StaticResource Lbl}"/>
                                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Ivs, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontSize="11" Margin="0,1"
                                                     ToolTip="HP, Atk, Def, Speed, SpAtk, SpDef (0–31)"/>
                                            <TextBlock Grid.Row="7" Text="Nickname" Style="{StaticResource Lbl}"/>
                                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Nickname, UpdateSourceTrigger=LostFocus}" MaxLength="10" Margin="0,1"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Values are constants of your branch (type to search). Empty moves: the Pokémon uses its level-up moves. Saving shows the changed file first; only this trainer's block is rewritten."/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
