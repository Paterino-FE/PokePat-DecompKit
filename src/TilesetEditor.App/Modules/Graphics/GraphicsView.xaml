<UserControl x:Class="TilesetEditor.App.Modules.Graphics.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="Area" Style="{StaticResource SectionTitle}"/>
            <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}" AutomationProperties.Name="Graphics areas"/>
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="Images" Style="{StaticResource SectionTitle}"/>
            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" FontFamily="Consolas" FontSize="11"
                     VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Images"/>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Content="Replace image…" Command="{Binding ReplaceCommand}" FontWeight="SemiBold"/>
                <Button Content="Save a copy to edit…" Command="{Binding ExportCommand}"/>
                <Button Content="Show in Explorer" Command="{Binding OpenFolderCommand}"/>
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox ItemsSource="{Binding Zooms}" SelectedItem="{Binding Zoom}" Width="50"/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Details}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Swatches}" Margin="0,6,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="16" Height="16" Margin="0,0,2,2" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" Background="{Binding Brush}" ToolTip="{Binding Tip}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="How to change an image: save a copy, edit it in any paint program (same size), then use Replace image. Index 0 / transparent pixels stay transparent in game. You see a before/after comparison and the file list before anything is written."/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image Source="{Binding Preview}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
